---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ui from '../data/ui.json';
import photos from '../data/photos.json';

export async function getStaticPaths() {
  return (await getCollection('pages')).map(page => ({
    params: { path: [page.data.lang, page.data.route].filter(Boolean).join('/') },
    props: { page },
  }));
}
const { page } = Astro.props;
const { title, description, lang, route: slug, verified } = page.data;
const { Content } = await render(page);
const c = ui[lang];
const categories = [
  { slug: 'dogs', title: c.dog, description: c.dogdesc, image: photos.dog },
  { slug: 'humanoids', title: c.human, description: c.humandesc, image: photos.human },
];
const guides = ['go2', 'models', 'buy', 'edu', 'used'];
const parents = { go2: 'dogs', edu: 'dogs', used: 'dogs', models: 'humanoids' };
const parentTitles = { dogs: c.dog, humanoids: c.human };
const related = {
  go2: ['models', 'buy', 'used'],
  models: ['go2', 'buy'],
  buy: ['go2', 'models', 'used'],
  edu: ['go2', 'buy'],
  used: ['go2', 'buy'],
};
---
<Base lang={lang} title={title} description={description} slug={slug}>
  {slug === '' ? <>
    <section class="hero"><h1>{title}</h1><p>{description}</p></section>
    <div class="paths">
      {categories.map(category => <article class="path">
        <figure>
          <img src={category.image.src} alt={category.image.alt[lang]} width={category.image.width} height={category.image.height} />
          <figcaption>{category.image.caption[lang]} <a href={category.image.source}>{category.image.author}</a>, <a href={category.image.licenseUrl}>{category.image.license}</a>. {category.image.changes[lang]}</figcaption>
        </figure>
        <h2>{category.title}</h2><p>{category.description}</p>
        <a href={`/${lang}/${category.slug}/`}>{c.explore} {category.title.toLowerCase()}</a>
      </article>)}
    </div>
    <section class="section">
      <h2>{c.start}</h2><p class="intro">{c.startdesc}</p>
      <div class="guides">{guides.map((guide, i) => <article class="guide">
        <h3><a href={`/${lang}/${guide}/`}>{c.titles[i]}</a></h3><p>{c.descs[i]}</p>
      </article>)}</div>
    </section>
    <section class="home-method"><h2>{c.methodtitle}</h2><p>{c.methodbody}</p><a href={`/${lang}/method/`}>{c.method}</a></section>
  </> : <article class="article">
    <nav class="breadcrumb" aria-label={lang === 'it' ? 'Percorso' : 'Breadcrumb'}>
      <a href={`/${lang}/`}>Home</a>
      {parents[slug] && <><span aria-hidden="true"> › </span><a href={`/${lang}/${parents[slug]}/`}>{parentTitles[parents[slug]]}</a></>}
      <span aria-hidden="true"> › </span><span aria-current="page">{title}</span>
    </nav>
    <h1>{title}</h1>
    {guides.includes(slug) && <p>{lang === 'it' ? 'A cura di ' : 'By '}<a href={`/${lang}/method/`}>Robot Unpacked</a></p>}
    {verified && <p class="meta">{lang === 'it' ? 'Fonti consultate' : 'Sources consulted'}: <time datetime={verified}>{verified}</time>. {lang === 'it' ? 'Confronto documentale, hardware non provato da noi.' : 'Document-based comparison, hardware not tested by us.'}</p>}
    <Content />
    {guides.includes(slug) && <section class=\"related\" aria-label={c.related}>
      <h2>{c.related}</h2>
      {related[slug].map(r => { const i = guides.indexOf(r); return (
        <article class=\"guide\"><h3><a href={`/${lang}/${r}/`}>{c.titles[i]}</a></h3><p>{c.descs[i]}</p></article>
      ); })}
    </section>}
  </article>}
</Base>
