---
import '../styles/global.css';
import ui from '../data/ui.json';
interface Props {
  lang: 'it' | 'en';
  title: string;
  description: string;
  slug: string;
}
const { lang, title, description, slug } = Astro.props;
const c = ui[lang];
const other = lang === 'it' ? 'en' : 'it';
const site = (process.env.SITE ?? '').trim().replace(/\/+$/, '');
const canonical = site ? `${site}/${lang}/${slug ? `${slug}/` : ''}` : '';
const alternate = site ? `${site}/${other}/${slug ? `${slug}/` : ''}` : '';
const links = [
  { slug: 'dogs', label: c.dog },
  { slug: 'humanoids', label: c.human },
  { slug: 'method', label: c.method },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | ${c.brand}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <meta property="og:locale:alternate" content={other === 'it' ? 'it_IT' : 'en_US'} />
    {/* og:image intentionally absent: no approved social graphic yet; wire it with SITE at graphic approval. */}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {alternate && <link rel="alternate" hreflang={other} href={alternate} />}
    {site && <link rel="alternate" hreflang="x-default" href={`${site}/${slug ? `${slug}/` : ''}`} />}
    <meta name="twitter:card" content="summary" />
    <title>{title} | {c.brand}</title>
  </head>
  <body id="top">
    <a class="skip" href="#main">{c.skip}</a>
    <header>
      <a class="brand" href={`/${lang}/`}>{c.brand}<small>{c.subtitle}</small></a>
      <nav aria-label={lang === 'it' ? 'Navigazione' : 'Navigation'}>
        {links.map(link => <a href={`/${lang}/${link.slug}/`} aria-current={slug === link.slug ? 'page' : undefined}>{link.label}</a>)}
        <details class="langswitch">
          <summary aria-haspopup="listbox" aria-label={lang === 'it' ? 'Lingua' : 'Language'}>{lang === 'it' ? 'Italiano' : 'English'}</summary>
          {lang === 'it'
            ? <a href={`/en/${slug ? `${slug}/` : ''}`} lang="en" hreflang="en" role="option">English</a>
            : <a href={`/it/${slug ? `${slug}/` : ''}`} lang="it" hreflang="it" role="option">Italiano</a>}
        </details>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer><p>{c.footer} — <a href={`/${lang}/method/`}>{c.method}</a>. {lang === 'it' ? 'Foto ritagliate e convertite in WebP rispetto agli originali.' : 'Photos cropped and converted to WebP from the originals.'}</p></footer>
  </body>
</html>
