---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ui from '../data/ui.json';
import photos from '../data/photos.json';
import glossary from '../data/glossary.json';

export async function getStaticPaths() {
  return (await getCollection('pages')).map(page => ({
    params: { path: [page.data.lang, page.data.route].filter(Boolean).join('/') },
    props: { page },
  }));
}
const { page } = Astro.props;
const { title, description, lang, route: slug, verified } = page.data;
const { Content } = await render(page);
const c = ui[lang];
const categories = [
  { slug: 'dogs', title: c.dog, description: c.dogdesc, image: photos.dog },
  { slug: 'humanoids', title: c.human, description: c.humandesc, image: photos.offG1 },
];
const guides = ['go2', 'models', 'home', 'buy', 'edu', 'used'];
const allPages = await getCollection('pages');
const verifiedBySlug = Object.fromEntries(allPages.filter(p => p.data.lang === lang && guides.includes(p.data.route)).map(p => [p.data.route, p.data.verified]));
const guideTags = [c.tagDog, c.tagHum, c.tagHum, c.tagBuy, c.tagDog, c.tagBuy];
const guideImages = [photos.offGo2, photos.offR1, photos.offG1, photos.human, photos.dog, photos.jmsBooth];
const tagBySlug = { go2: c.tagDog, models: c.tagHum, home: c.tagHum, buy: c.tagBuy, edu: c.tagDog, used: c.tagBuy };
const catData = {
  dogs: { tag: c.tagDog, img: photos.dog, list: ['go2', 'edu', 'buy', 'used'] },
  humanoids: { tag: c.tagHum, img: photos.offG1, list: ['models', 'home'] },
};
const isCat = slug === 'dogs' || slug === 'humanoids';
const isGlossary = slug === 'glossary';
const glossSlug = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-');
const glossTerms = [...glossary].sort((a, b) => a.term[lang].localeCompare(b.term[lang], lang));
const isGuide = guides.includes(slug);
const readMins = Math.max(1, Math.round(page.body.split(/\s+/).length / 200));
const gIdx = guides.indexOf(slug);
const prevG = gIdx > 0 ? guides[gIdx - 1] : null;
const nextG = gIdx >= 0 && gIdx < guides.length - 1 ? guides[gIdx + 1] : null;
const parents = { go2: 'dogs', edu: 'dogs', buy: 'dogs', used: 'dogs', models: 'humanoids', home: 'humanoids' };
const parentTitles = { dogs: c.dog, humanoids: c.human };
const site = (process.env.SITE ?? '').trim().replace(/\/+$/, '');
const articleJson = { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, inLanguage: lang, author: { '@type': 'Organization', name: c.brand }, publisher: { '@type': 'Organization', name: c.brand } };
if (verified) { articleJson.datePublished = verified; articleJson.dateModified = verified; }
const crumbItems = [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/${lang}/` }];
if (parents[slug]) crumbItems.push({ '@type': 'ListItem', position: 2, name: parentTitles[parents[slug]], item: `${site}/${lang}/${parents[slug]}/` });
crumbItems.push({ '@type': 'ListItem', position: crumbItems.length + 1, name: title, item: `${site}/${lang}/${slug}/` });
const related = {
  go2: ['models', 'buy', 'used'],
  models: ['home', 'go2', 'buy'],
  home: ['models', 'buy'],
  buy: ['go2', 'models', 'used'],
  edu: ['go2', 'buy'],
  used: ['go2', 'buy'],
};
const toc = {
  go2: {
    it: [['Non cambia soltanto la velocità', '#non-cambia-soltanto-la-velocità'], ['Programmazione: due cose diverse', '#programmazione-due-cose-diverse'], ['Cosa significano carico e autonomia', '#cosa-significano-carico-e-autonomia'], ['Il prezzo da confrontare', '#il-prezzo-da-confrontare'], ['Una discrepanza da chiarire', '#una-discrepanza-da-chiarire'], ['Cosa aggiungono le prove di terzi', '#cosa-aggiungono-le-prove-di-terzi'], ['Prima di pagare, fatti confermare', '#prima-di-pagare-fatti-confermare'], ['Fonti', '#fonti']],
    en: [['More than a speed difference', '#more-than-a-speed-difference'], ['Two meanings of programming', '#two-meanings-of-programming'], ['What payload and runtime mean', '#what-payload-and-runtime-mean'], ['Compare like-for-like prices', '#compare-like-for-like-prices'], ['A discrepancy to resolve', '#a-discrepancy-to-resolve'], ['What third-party tests add', '#what-third-party-tests-add'], ['Get these confirmed before paying', '#get-these-confirmed-before-paying'], ['Sources', '#sources']],
  },
  models: {
    it: [['In breve: quale approfondire?', '#in-breve-quale-approfondire'], ['Prezzi: non sono tre preventivi confrontabili', '#prezzi-non-sono-tre-preventivi-confrontabili'], ['Le differenze che cambiano l\u2019acquisto', '#le-differenze-che-cambiano-lacquisto'], ['R1: prezzo iniziale basso, ma attenzione alla versione', '#r1-prezzo-iniziale-basso-ma-attenzione-alla-versione'], ['G1: conta la configurazione delle mani, non il video', '#g1-conta-la-configurazione-delle-mani-non-il-video'], ['K1: la Geek non è semplicemente una Education scontata', '#k1-la-geek-non-è-semplicemente-una-education-scontata'], ['Competenze e prova prima dell\u2019ordine', '#competenze-e-prova-prima-dellordine'], ['Evidenze indipendenti da aggiornare', '#evidenze-indipendenti-da-aggiornare'], ['Cosa chiedere nel preventivo europeo', '#cosa-chiedere-nel-preventivo-europeo'], ['Fonti', '#fonti']],
    en: [['In brief: which should you investigate?', '#in-brief-which-should-you-investigate'], ['Prices: these are not comparable quotations', '#prices-these-are-not-comparable-quotations'], ['Differences that affect the purchase', '#differences-that-affect-the-purchase'], ['R1: a low starting price, but the version matters', '#r1-a-low-starting-price-but-the-version-matters'], ['G1: the hand configuration matters more than the video', '#g1-the-hand-configuration-matters-more-than-the-video'], ['K1: Geek is not simply a discounted Education', '#k1-geek-is-not-simply-a-discounted-education'], ['Skills and a demonstration before ordering', '#skills-and-a-demonstration-before-ordering'], ['Independent evidence to update', '#independent-evidence-to-update'], ['What to request in a European quotation', '#what-to-request-in-a-european-quotation'], ['Sources', '#sources']],
  },
  buy: {
    it: [['1. Venditore e magazzino non sono la stessa cosa', '#1-venditore-e-magazzino-non-sono-la-stessa-cosa'], ['2. Chiedi il costo consegnato, non solo il listino', '#2-chiedi-il-costo-consegnato-non-solo-il-listino'], ['3. Acquisto privato e acquisto aziendale', '#3-acquisto-privato-e-acquisto-aziendale'], ['4. Recesso e guasto sono due cose diverse', '#4-recesso-e-guasto-sono-due-cose-diverse'], ['5. Assistenza, ricambi e conformità', '#5-assistenza-ricambi-e-conformità'], ['6. Prima di pagare: sei risposte scritte', '#6-prima-di-pagare-sei-risposte-scritte'], ['Fonti', '#fonti']],
    en: [['1. The seller and the warehouse are different things', '#1-the-seller-and-the-warehouse-are-different-things'], ['2. Request the delivered cost, not just the list price', '#2-request-the-delivered-cost-not-just-the-list-price'], ['3. Consumer purchases and business purchases', '#3-consumer-purchases-and-business-purchases'], ['4. Withdrawal and faulty goods are different issues', '#4-withdrawal-and-faulty-goods-are-different-issues'], ['5. Support, spare parts and conformity', '#5-support-spare-parts-and-conformity'], ['6. Before paying: six written answers', '#6-before-paying-six-written-answers'], ['Sources', '#sources']],
  },
  edu: {
    it: [['Pro, X o EDU: cosa verificare?', '#pro-x-o-edu-cosa-verificare'], ['Software e manutenzione: cosa serve al progetto?', '#software-e-manutenzione-cosa-serve-al-progetto'], ['Cosa chiedere nel preventivo', '#cosa-chiedere-nel-preventivo'], ['Fonti', '#fonti']],
    en: [['Pro, X or EDU: what should you check?', '#pro-x-or-edu-what-should-you-check'], ['Software and maintenance: what does the project need?', '#software-and-maintenance-what-does-the-project-need'], ['What to request in a quotation', '#what-to-request-in-a-quotation'], ['Sources', '#sources']],
  },
  used: {
    it: [['Chi vende e quali tutele si applicano?', '#chi-vende-e-quali-tutele-si-applicano'], ['Confronta la configurazione e il costo completo', '#confronta-la-configurazione-e-il-costo-completo'], ['Prova il robot e verifica la documentazione', '#prova-il-robot-e-verifica-la-documentazione'], ['Fonti', '#fonti']],
    en: [['Who is selling, and what protection applies?', '#who-is-selling-and-what-protection-applies'], ['Compare the configuration and full cost', '#compare-the-configuration-and-full-cost'], ['Test the robot and check the paperwork', '#test-the-robot-and-check-the-paperwork'], ['Sources', '#sources']],
  },
  home: {
    it: [['Cosa sanno fare davvero nel 2026', '#cosa-sanno-fare-davvero-nel-2026'], ['Casa: scale, spazio e batteria', '#casa-scale-spazio-e-batteria'], ['Azienda: accoglienza, eventi e negozi', '#azienda-accoglienza-eventi-e-negozi'], ['Sicurezza: cosa chiedere prima', '#sicurezza-cosa-chiedere-prima'], ['Prima di comprarlo per un ambiente: cinque risposte scritte', '#prima-di-comprarlo-per-un-ambiente-cinque-risposte-scritte'], ['Fonti', '#fonti']],
    en: [['What they can really do in 2026', '#what-they-can-really-do-in-2026'], ['Home: stairs, space and battery', '#home-stairs-space-and-battery'], ['Business: reception, events and shops', '#business-reception-events-and-shops'], ['Safety: what to ask first', '#safety-what-to-ask-first'], ['Before buying for a space: five written answers', '#before-buying-for-a-space-five-written-answers'], ['Sources', '#sources']],
  },
  method: {
    it: [['Chi prepara le guide', '#chi-prepara-le-guide'], ['Dichiarato dal produttore', '#dichiarato-dal-produttore'], ['Dichiarato dal venditore', '#dichiarato-dal-venditore'], ['Provato da terzi', '#provato-da-terzi'], ['Provato da noi', '#provato-da-noi']],
    en: [['Who prepares the guides', '#who-prepares-the-guides'], ['Manufacturer statement', '#manufacturer-statement'], ['Seller statement', '#seller-statement'], ['Third-party test', '#third-party-test'], ['Our own test', '#our-own-test']],
  },
};
const dateLabel = verified ? new Date(`${verified}T12:00:00`).toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---
<Base lang={lang} title={title} description={description} slug={slug}>
  {slug === '' ? <>
    <section class="hero">
      <div>
        <p class="kicker">{c.kicker}</p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <p class="hero-cta"><a class="btn" href={`/${lang}/#guide`}>{c.heroCtaGuides}</a><a class="ghost" href={`/${lang}/method/`}>{c.heroCtaMethod} →</a></p>
      </div>
      <figure>
        <img src={photos.jmsBooth.src} alt={photos.jmsBooth.alt[lang]} width={photos.jmsBooth.width} height={photos.jmsBooth.height} fetchpriority="high" />
        <figcaption>{photos.jmsBooth.caption[lang]} {photos.jmsBooth.caption[lang].includes(photos.jmsBooth.author) ? '' : <><a href={photos.jmsBooth.source}>{photos.jmsBooth.author}</a>, </>}<a href={photos.jmsBooth.licenseUrl}>{photos.jmsBooth.license}</a>.</figcaption>
      </figure>
    </section>
    <section class="statsband" aria-label={c.statsSources}>
      <div><strong>{guides.length}</strong><span>{c.statsGuides}</span></div>
      <div><strong>2</strong><span>{c.statsPaths}</span></div>
      <div><strong>7</strong><span>{c.statsVersions}</span></div>
      <div><strong>35</strong><span>{c.statsSources}</span></div>
    </section>
    <section class="sec">
      <p class="sec-label">{c.pathsLabel}</p>
      <div class="paths">
      {categories.map(category => <article class="path">
        <figure>
          <img src={category.image.src} alt={category.image.alt[lang]} width={category.image.width} height={category.image.height} />
          <figcaption title={`${category.image.caption[lang]} ${category.image.author}, ${category.image.license}`}>{category.image.caption[lang]} {category.image.caption[lang].includes(category.image.author) ? '' : <><a href={category.image.source}>{category.image.author}</a>, </>}<a href={category.image.licenseUrl}>{category.image.license}</a>.</figcaption>
        </figure>
        <h2>{category.title}</h2><p>{category.description}</p>
        <a href={`/${lang}/${category.slug}/`}>{c.explore} {category.title.toLowerCase()}</a>
      </article>)}
      </div>
    </section>
    <section class="sec" id="guide">
      <p class="sec-label">{c.guidesLabel}</p>
      <h2>{c.start}</h2><p class="intro">{c.startdesc}</p>
      <div class="gcards">{guides.map((g, i) => { const img = guideImages[i]; return (
        <article class={i === 0 ? 'gcard featured' : 'gcard'}>
          <figure>
            <img src={img.src} alt={img.alt[lang]} width={img.width} height={img.height} loading="lazy" />
            <figcaption>{img.caption[lang].includes(img.author) ? img.caption[lang] : <>{img.caption[lang]} <a href={img.source}>{img.author}</a></>} · <a href={img.licenseUrl}>{img.license}</a></figcaption>
          </figure>
          <div>
            <p class="tag">{guideTags[i]}</p>
            <h3><a href={`/${lang}/${g}/`}>{c.titles[i]}</a></h3>
            <p>{c.descs[i]}</p>
            <a class="more" href={`/${lang}/${g}/`}>{c.readGuide} →</a>
          </div>
        </article>); })}
      </div>
    </section>
    <section class="sec">
      <p class="sec-label">{c.methodLabel}</p>
      <div class="home-method"><h2>{c.methodtitle}</h2><p>{c.methodbody}</p><a href={`/${lang}/method/`}>{c.method}</a></div>
    </section>
    <section class="faq"><Content /></section>
    <section class="closer">
      <h2>{c.closerTitle}</h2>
      <p>{c.closerBody}</p>
      <a class="btn" href={`/${lang}/buy/`}>{c.closerCta}</a>
    </section>
  </> : isCat ? <>
    <nav class="breadcrumb" aria-label={lang === 'it' ? 'Percorso' : 'Breadcrumb'}>
      <a href={`/${lang}/`}>Home</a>
      <span aria-hidden="true"> › </span><span aria-current="page">{title}</span>
    </nav>
    <section class="cat-hero">
      <div>
        <p class="kicker">{c.kicker}</p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <p class="cat-count"><strong>{catData[slug].list.length}</strong> {catData[slug].list.length === 1 ? (lang === 'it' ? 'guida' : 'guide') : c.statsGuides}</p>
      </div>
      <figure>
        <img src={catData[slug].img.src} alt={catData[slug].img.alt[lang]} width={catData[slug].img.width} height={catData[slug].img.height} />
        <figcaption>{catData[slug].img.caption[lang].includes(catData[slug].img.author) ? catData[slug].img.caption[lang] : <>{catData[slug].img.caption[lang]} <a href={catData[slug].img.source}>{catData[slug].img.author}</a></>} · <a href={catData[slug].img.licenseUrl}>{catData[slug].img.license}</a>.</figcaption>
      </figure>
    </section>
    <div class="cat-body"><Content /></div>
    <section class="sec">
      <p class="sec-label">{c.guidesSection}</p>
      <div class="gcards">{catData[slug].list.map(g => { const i = guides.indexOf(g); const img = guideImages[i]; return (
        <article class="gcard">
          <figure>
            <img src={img.src} alt={img.alt[lang]} width={img.width} height={img.height} loading="lazy" />
            <figcaption>{img.caption[lang].includes(img.author) ? img.caption[lang] : <>{img.caption[lang]} <a href={img.source}>{img.author}</a></>} · <a href={img.licenseUrl}>{img.license}</a></figcaption>
          </figure>
          <div>
            {catData[slug].list.length > 1 && <p class="tag">{guideTags[i]}</p>}
            <h3><a href={`/${lang}/${g}/`}>{c.titles[i]}</a></h3>
            <p>{c.descs[i]}</p>
            <a class="more" href={`/${lang}/${g}/`}>{c.readGuide} →</a>
          </div>
        </article>); })}
      </div>
      {slug === 'humanoids' && <p class="soon">{c.soon}</p>}
      {slug === 'humanoids' && <p class="soon">{c.alsoUseful}: <a href={`/${lang}/buy/`}>{c.titles[3]}</a></p>}
    </section>
  </> : isGlossary ? <>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: title, inLanguage: lang, hasDefinedTerm: glossTerms.map(t => ({ '@type': 'DefinedTerm', name: t.term[lang], description: t.def[lang], inLanguage: lang })) })} />
    <nav class="breadcrumb" aria-label={lang === 'it' ? 'Percorso' : 'Breadcrumb'}>
      <a href={`/${lang}/`}>Home</a>
      <span aria-hidden="true"> › </span><span aria-current="page">{title}</span>
    </nav>
    <p class="kicker">{c.kicker}</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    <div class="cat-body"><Content /></div>
    <nav class="gloss-index" aria-label={c.glossIndex}>
      {glossTerms.map(t => <a href={`#${glossSlug(t.term[lang])}`}>{t.term[lang]}</a>)}
    </nav>
    <dl class="gloss">
      {glossTerms.map(t => (
        <div id={glossSlug(t.term[lang])}>
          <dt>{t.term[lang]}</dt>
          <dd>{t.def[lang]}</dd>
          <dd class="gloss-see">{c.glossSee}: {t.guides.map((g, gi) => <><a href={`/${lang}/${g}/`}>{c.titles[guides.indexOf(g)]}</a>{gi < t.guides.length - 1 && ' · '}</>)}{t.source && <> · {c.glossSource}: <a href={t.source.url}>{t.source.label[lang]}</a></>}</dd>
        </div>))}
    </dl>
  </> : <article class="article">
    <script type="application/ld+json" set:html={JSON.stringify(articleJson)} />
    {site && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbItems })} />}
    <nav class="breadcrumb" aria-label={lang === 'it' ? 'Percorso' : 'Breadcrumb'}>
      <a href={`/${lang}/`}>Home</a>
      {parents[slug] && <><span aria-hidden="true"> › </span><a href={`/${lang}/${parents[slug]}/`}>{parentTitles[parents[slug]]}</a></>}
      <span aria-hidden="true"> › </span><span aria-current="page">{title}</span>
    </nav>
    <p class="kicker">{isGuide ? tagBySlug[slug] : c.method}</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    {isGuide
      ? <p class="artmeta"><span>{lang === 'it' ? 'A cura di' : 'By'} <a href={`/${lang}/method/`}>Robot Unpacked</a></span><span>{readMins} {c.readTime}</span>{verified && <span>{lang === 'it' ? 'Fonti consultate' : 'Sources consulted'}: <time datetime={verified}>{dateLabel}</time></span>}</p>
      : <>{verified && <p class="meta">{lang === 'it' ? 'Fonti consultate' : 'Sources consulted'}: <time datetime={verified}>{dateLabel}</time>.</p>}</>}
    {toc[slug]?.[lang] && <nav class="toc" aria-label={c.tocTitle}>
      <h2>{c.tocTitle}</h2>
      <ol>{toc[slug][lang].map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ol>
    </nav>}
    <Content />
    {isGuide && <aside class="authorbox"><h2>{c.methodtitle}</h2><p>{c.methodbody}</p><a href={`/${lang}/method/`}>{c.method} →</a></aside>}
    {isGuide && <nav class="prevnext" aria-label={lang === 'it' ? 'Guide precedente e successiva' : 'Previous and next guides'}>
      {prevG ? <a class="prev" href={`/${lang}/${prevG}/`}>← {c.prevGuide}<strong>{c.titles[guides.indexOf(prevG)]}</strong></a> : <span />}
      {nextG && <a class="next" href={`/${lang}/${nextG}/`}>{c.nextGuide} →<strong>{c.titles[guides.indexOf(nextG)]}</strong></a>}
    </nav>}
    {isGuide && <section class="related" aria-label={c.related}>
      <h2>{c.related}</h2>
      <div class="gcards">{related[slug].map(r => { const i = guides.indexOf(r); const img = guideImages[i]; return (
        <article class="gcard">
          <figure>
            <img src={img.src} alt={img.alt[lang]} width={img.width} height={img.height} loading="lazy" />
            <figcaption>{img.caption[lang].includes(img.author) ? img.caption[lang] : <>{img.caption[lang]} <a href={img.source}>{img.author}</a></>} · <a href={img.licenseUrl}>{img.license}</a></figcaption>
          </figure>
          <div>
            <p class="tag">{guideTags[i]}</p>
            <h3><a href={`/${lang}/${r}/`}>{c.titles[i]}</a></h3>
            <p>{c.descs[i]}</p>
            <a class="more" href={`/${lang}/${r}/`}>{c.readGuide} →</a>
          </div>
        </article>); })}
      </div>
    </section>}
  </article>}
</Base>
