---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ui from '../data/ui.json';
import photos from '../data/photos.json';

export async function getStaticPaths() {
  return (await getCollection('pages')).map(page => ({
    params: { path: [page.data.lang, page.data.route].filter(Boolean).join('/') },
    props: { page },
  }));
}
const { page } = Astro.props;
const { title, description, lang, route: slug, verified } = page.data;
const { Content } = await render(page);
const c = ui[lang];
const categories = [
  { slug: 'dogs', title: c.dog, description: c.dogdesc, image: photos.dog },
  { slug: 'humanoids', title: c.human, description: c.humandesc, image: photos.human },
];
const guides = ['go2', 'models', 'buy', 'edu', 'used'];
const parents = { go2: 'dogs', edu: 'dogs', used: 'dogs', models: 'humanoids' };
const parentTitles = { dogs: c.dog, humanoids: c.human };
const related = {
  go2: ['models', 'buy', 'used'],
  models: ['go2', 'buy'],
  buy: ['go2', 'models', 'used'],
  edu: ['go2', 'buy'],
  used: ['go2', 'buy'],
};
const toc = {
  go2: {
    it: [['Cosa cambia', '#non-cambia-soltanto-la-velocità'], ['Programmazione', '#programmazione-due-cose-diverse'], ['Prezzi', '#il-prezzo-da-confrontare'], ['Discrepanza da chiarire', '#una-discrepanza-da-chiarire'], ['Prove di terzi', '#cosa-aggiungono-le-prove-di-terzi'], ['Checklist e fonti', '#prima-di-pagare-fatti-confermare']],
    en: [['What changes', '#more-than-a-speed-difference'], ['Programming', '#two-meanings-of-programming'], ['Prices', '#compare-like-for-like-prices'], ['Discrepancy to resolve', '#a-discrepancy-to-resolve'], ['Third-party tests', '#what-third-party-tests-add'], ['Checklist and sources', '#get-these-confirmed-before-paying']],
  },
  models: {
    it: [['In breve', '#in-breve-quale-approfondire'], ['Prezzi', '#prezzi-non-sono-tre-preventivi-confrontabili'], ['R1', '#r1-prezzo-iniziale-basso-ma-attenzione-alla-versione'], ['G1', '#g1-conta-la-configurazione-delle-mani-non-il-video'], ['K1', '#k1-la-geek-non-è-semplicemente-una-education-scontata'], ['Preventivo europeo', '#cosa-chiedere-nel-preventivo-europeo']],
    en: [['In brief', '#in-brief-which-should-you-investigate'], ['Prices', '#prices-these-are-not-comparable-quotations'], ['R1', '#r1-a-low-starting-price-but-the-version-matters'], ['G1', '#g1-the-hand-configuration-matters-more-than-the-video'], ['K1', '#k1-geek-is-not-simply-a-discounted-education'], ['European quotation', '#what-to-request-in-a-european-quotation']],
  },
  buy: {
    it: [['Venditore e magazzino', '#1-venditore-e-magazzino-non-sono-la-stessa-cosa'], ['Costo consegnato', '#2-chiedi-il-costo-consegnato-non-solo-il-listino'], ['Privato e aziendale', '#3-acquisto-privato-e-acquisto-aziendale'], ['Recesso e guasto', '#4-recesso-e-guasto-sono-due-cose-diverse'], ['Assistenza e ricambi', '#5-assistenza-ricambi-e-conformità'], ['Sei risposte scritte', '#6-prima-di-pagare-sei-risposte-scritte']],
    en: [['Seller and warehouse', '#1-the-seller-and-the-warehouse-are-different-things'], ['Delivered cost', '#2-request-the-delivered-cost-not-just-the-list-price'], ['Consumer and business', '#3-consumer-purchases-and-business-purchases'], ['Withdrawal and faults', '#4-withdrawal-and-faulty-goods-are-different-issues'], ['Support and spares', '#5-support-spare-parts-and-conformity'], ['Six written answers', '#6-before-paying-six-written-answers']],
  },
  edu: {
    it: [['Pro, X o EDU', '#pro-x-o-edu-cosa-verificare'], ['Software e manutenzione', '#software-e-manutenzione-cosa-serve-al-progetto'], ['Preventivo', '#cosa-chiedere-nel-preventivo'], ['Fonti', '#fonti']],
    en: [['Pro, X or EDU', '#pro-x-or-edu-what-should-you-check'], ['Quotation', '#what-to-request-in-a-quotation'], ['Sources', '#sources']],
  },
  used: {
    it: [['Chi vende', '#chi-vende-e-quali-tutele-si-applicano'], ['Configurazione e costo', '#confronta-la-configurazione-e-il-costo-completo'], ['Prova e documenti', '#prova-il-robot-e-verifica-la-documentazione'], ['Fonti', '#fonti']],
    en: [['Seller', '#who-is-selling-and-what-protection-applies'], ['Configuration and cost', '#compare-the-configuration-and-full-cost'], ['Test and paperwork', '#test-the-robot-and-check-the-paperwork'], ['Sources', '#sources']],
  },
  method: {
    it: [['Chi prepara', '#chi-prepara-le-guide'], ['Produttore', '#dichiarato-dal-produttore'], ['Venditore', '#dichiarato-dal-venditore'], ['Prove di terzi', '#provato-da-terzi'], ['Prove nostre', '#provato-da-noi']],
    en: [['Who prepares', '#who-prepares-the-guides'], ['Manufacturer', '#manufacturer-statement'], ['Seller', '#seller-statement'], ['Third-party', '#third-party-test'], ['Our tests', '#our-own-test']],
  },
};
const dateLabel = verified ? new Date(`${verified}T12:00:00`).toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---
<Base lang={lang} title={title} description={description} slug={slug}>
  {slug === '' ? <>
    <section class="hero"><h1>{title}</h1><p>{description}</p><p class="stats">{guides.length} {c.statsGuides} · 3 {c.statsPaths} · {c.statsLangs}</p></section>
    <div class="paths">
      {categories.map(category => <article class="path">
        <figure>
          <img src={category.image.src} alt={category.image.alt[lang]} width={category.image.width} height={category.image.height} />
          <figcaption title={`${category.image.caption[lang]} ${category.image.author}, ${category.image.license}`}>{category.image.caption[lang]} <a href={category.image.source}>{category.image.author}</a>, <a href={category.image.licenseUrl}>{category.image.license}</a>.</figcaption>
        </figure>
        <h2>{category.title}</h2><p>{category.description}</p>
        <a href={`/${lang}/${category.slug}/`}>{c.explore} {category.title.toLowerCase()}</a>
      </article>)}
    </div>
    <section class="section">
      <h2>{c.start}</h2><p class="intro">{c.startdesc}</p>
      {[{ title: c.dog, items: [0, 3] }, { title: c.human, items: [1], soon: c.soon }, { title: c.buying, items: [2, 4] }].map(group => <div class="group">
        <h3>{group.title}</h3>
        {group.soon && <p class="soon">{group.soon}</p>}
        <div class="guides">{group.items.map(i => <article class="guide">
          <h3><a href={`/${lang}/${guides[i]}/`}>{c.titles[i]}</a></h3><p>{c.descs[i]}</p>
        </article>)}</div>
      </div>)}
    </section>
    <section class="home-method"><h2>{c.methodtitle}</h2><p>{c.methodbody}</p><a href={`/${lang}/method/`}>{c.method}</a></section>
    <section class="faq"><Content /></section>
  </> : <article class="article">
    <nav class="breadcrumb" aria-label={lang === 'it' ? 'Percorso' : 'Breadcrumb'}>
      <a href={`/${lang}/`}>Home</a>
      {parents[slug] && <><span aria-hidden="true"> › </span><a href={`/${lang}/${parents[slug]}/`}>{parentTitles[parents[slug]]}</a></>}
      <span aria-hidden="true"> › </span><span aria-current="page">{title}</span>
    </nav>
    <h1>{title}</h1>
    {guides.includes(slug) && <p>{lang === 'it' ? 'A cura di ' : 'By '}<a href={`/${lang}/method/`}>Robot Unpacked</a></p>}
    {verified && <p class="meta">{lang === 'it' ? 'Fonti consultate' : 'Sources consulted'}: <time datetime={verified}>{dateLabel}</time>.</p>}
    {toc[slug]?.[lang] && <nav class="toc" aria-label={c.tocTitle}>
      <h2>{c.tocTitle}</h2>
      <ol>{toc[slug][lang].map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ol>
    </nav>}
    <Content />
    {guides.includes(slug) && <section class=\"related\" aria-label={c.related}>
      <h2>{c.related}</h2>
      {related[slug].map(r => { const i = guides.indexOf(r); return (
        <article class=\"guide\"><h3><a href={`/${lang}/${r}/`}>{c.titles[i]}</a></h3><p>{c.descs[i]}</p></article>
      ); })}
    </section>}
  </article>}
</Base>
